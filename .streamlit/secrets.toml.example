# Copy this file to .streamlit/secrets.toml for local development.
# Never commit the real secrets.toml file.

DATABASE_URL = "postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
GEMINI_API_KEYS = "key-one,key-two"

# Production/closed-alpha default: Gemini live generation.
DEV_AI_MOCK = false
DEV_AI_MOCK_DELAY = 0.25

# V3 dialogue presentation is enabled by default. Set false only for legacy QA.
DIALOGUE_SCENE_RUNTIME_V1 = true
